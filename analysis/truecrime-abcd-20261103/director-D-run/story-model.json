  "quotes": [
    {
      "id": "q1",
      "eventId": "evt_initial_encounter",
      "speaker": "female_driver",
      "text": "No, you can't do anything.",
      "startSec": 54,
      "endSec": 56.5,
      "epistemic": "suspect_statement",
      "editorialValue": 0.75
    },
    {
      "id": "q2",
      "eventId": "evt_initial_encounter",
      "speaker": "deputy_female",
      "text": "Continue with the attitude and I'll tow your car myself right now.",
      "startSec": 59,
      "endSec": 62.5,
      "epistemic": "officer_claim",
      "editorialValue": 0.8
    },
    {
      "id": "q3",
      "eventId": "evt_911_call_audio",
      "speaker": "female_driver",
      "text": "I'm going to hang up until I get somebody that has a brain cell left.",
      "startSec": 156,
      "endSec": 160,
      "epistemic": "suspect_statement",
      "editorialValue": 0.95
    },
    {
      "id": "q4",
      "eventId": "evt_detention_arrest",
      "speaker": "deputy_male_2",
      "text": "If you don't stop, you're gonna go to jail for misuse of 911.",
      "startSec": 337,
      "endSec": 341.5,
      "epistemic": "officer_claim",
      "editorialValue": 0.85
    },
    {
      "id": "q5",
      "eventId": "evt_detention_arrest",
      "speaker": "female_driver",
      "text": "So I can wait for the tow truck.",
      "startSec": 443,
      "endSec": 444.5,
      "epistemic": "suspect_statement",
      "editorialValue": 0.7
    },
    {
      "id": "q6",
      "eventId": "evt_detention_arrest",
      "speaker": "deputy_male_2",
      "text": "No, that's ok, we're past that now.",
      "startSec": 444.8,
      "endSec": 446.5,
      "epistemic": "officer_claim",
      "editorialValue": 0.9
    },
    {
      "id": "q7",
      "eventId": "evt_search_vehicle",
      "speaker": "female_driver",
      "text": "You can pat me down at the station.",
      "startSec": 602.5,
      "endSec": 604.5,
      "epistemic": "suspect_statement",
      "editorialValue": 0.75
    },
    {
      "id": "q8",
      "eventId": "evt_supervisor_explanation",
      "speaker": "female_driver",
      "text": "Being rude is not illegal.",
      "startSec": 737.5,
      "endSec": 739.5,
      "epistemic": "suspect_statement",
      "editorialValue": 0.95
    },
    {
      "id": "q9",
      "eventId": "evt_supervisor_explanation",
      "speaker": "supervisor",
      "text": "Ok, well that's not an emergency.",
